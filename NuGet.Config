<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Project-local NuGet source. This machine has no package source
       configured, which makes vendor restores fail with NU1100. NuGet walks up
       from each project, so this applies to the whole repository tree without
       modifying the user-level %APPDATA%\NuGet\NuGet.Config. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
